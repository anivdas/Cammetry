<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Cammetry.exe"
             product-name="Cammetry"
             product-version="${version}"
             file-version="${version}"
             company-name="Cammetry Open Source Project">
      <authenticode-sign description="Cammetry" description-url="https://github.com/anivdas/Cammetry" />
    </pe-file>
    <pe-file path="Cammetry-Portable-v${version}.exe"
             product-name="Cammetry"
             product-version="${version}"
             file-version="${version}"
             company-name="Cammetry Open Source Project">
      <authenticode-sign description="Cammetry Portable" description-url="https://github.com/anivdas/Cammetry" />
    </pe-file>
  </zip-file>
</artifact-configuration>
